# Copy to `.env` for local work. Every variable here is validated by
# `src/env.schema.ts`, and a production build fails without them.

# The config-sharing worker (apps/server).
#   local      → http://localhost:8787   (what `bun dev` defaults to)
#   production → https://api.agentsinc.sh
VITE_API_URL=http://localhost:8787
