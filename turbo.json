{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      // VITE_API_URL is inlined into the bundle, so it is part of the build's
      // identity — without it here, a cached build from another environment
      // would be replayed with the wrong API baked in.
      "env": [
        "VITE_API_URL"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      // turbo runs tasks in a sanitized environment (envMode: strict), so
      // wrangler sees nothing that is not named here. `passThroughEnv` rather
      // than `env` because these are credentials: they must reach the task
      // without becoming part of any hash.
      "passThroughEnv": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
